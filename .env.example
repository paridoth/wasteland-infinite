# Reserved Director configuration; no networking/service is implemented in phase 1.
WI_PROVIDER=mock
WI_BIND_HOST=127.0.0.1
WI_BIND_PORT=8765
WI_DATABASE=runtime/director.sqlite3
# Future OpenAI-compatible provider options. Set secrets only in ignored .env.
WI_LLM_BASE_URL=http://127.0.0.1:11434/v1
WI_LLM_MODEL=
WI_LLM_API_KEY=
WI_LLM_TIMEOUT_SECONDS=3
WI_LLM_MAX_RETRIES=1
WI_LLM_MAX_TOKENS=256
WI_LLM_DAILY_BUDGET_USD=0
