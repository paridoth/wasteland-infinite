{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded two-object entry partition v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generator_version", "layout", "seed", "entry", "walkable", "protected", "blockers"],
  "properties": {
    "schema_version": {"const": 1},
    "generator_version": {"const": 1},
    "layout": {"const": "entry-partition.v1"},
    "seed": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "maxLength": 20},
    "entry": {"$ref": "#/$defs/hex"},
    "walkable": {"type": "array", "minItems": 6, "maxItems": 61, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}},
    "protected": {"type": "array", "minItems": 1, "maxItems": 61, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}},
    "blockers": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}}
  },
  "$defs": {"hex": {"type": "integer", "minimum": 0, "maximum": 39999}}
}
