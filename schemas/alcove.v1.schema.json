{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded five-object grove alcove v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generator_version", "module", "seed", "entry", "walkable", "protected", "interior", "opening", "blockers", "loot"],
  "properties": {
    "schema_version": {"const": 1},
    "generator_version": {"const": 1},
    "module": {"const": "grove-alcove.v1"},
    "seed": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "maxLength": 20},
    "entry": {"$ref": "#/$defs/hex"},
    "walkable": {"type": "array", "minItems": 10, "maxItems": 127, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}},
    "protected": {"type": "array", "minItems": 1, "maxItems": 127, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}},
    "interior": {"$ref": "#/$defs/hex"},
    "opening": {"$ref": "#/$defs/hex"},
    "blockers": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}},
    "loot": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/loot"}}
  },
  "$defs": {
    "hex": {"type": "integer", "minimum": 0, "maximum": 39999},
    "loot": {
      "type": "object", "additionalProperties": false,
      "required": ["hex", "prototype"],
      "properties": {
        "hex": {"$ref": "#/$defs/hex"},
        "prototype": {"enum": ["vanilla.money", "vanilla.stimpak"]}
      }
    }
  }
}
