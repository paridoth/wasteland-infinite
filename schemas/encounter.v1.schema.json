{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded alcove guard encounter v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generator_version", "encounter", "layout", "seed", "entry", "walkable", "protected", "entry_clearance", "enemy"],
  "properties": {
    "schema_version": {"const": 1},
    "generator_version": {"const": 1},
    "encounter": {"const": "alcove-guard.v1"},
    "layout": {"const": "grove-alcove.v1"},
    "seed": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "maxLength": 20},
    "entry": {"$ref": "#/$defs/hex"},
    "walkable": {"type": "array", "minItems": 5, "maxItems": 127, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}},
    "protected": {"type": "array", "minItems": 1, "maxItems": 127, "uniqueItems": true, "items": {"$ref": "#/$defs/hex"}},
    "entry_clearance": {"const": 4},
    "enemy": {
      "type": "object", "additionalProperties": false,
      "required": ["hex", "prototype"],
      "properties": {
        "hex": {"$ref": "#/$defs/hex"},
        "prototype": {"const": "template.hostile-ant"}
      }
    }
  },
  "$defs": {
    "hex": {"type": "integer", "minimum": 0, "maximum": 39999}
  }
}
